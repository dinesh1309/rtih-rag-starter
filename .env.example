# Copy this file to ".env" and paste the key for the provider you chose.
# You only need ONE of these. The starter defaults to OpenRouter.

# OpenRouter (default) — one key covers Claude, GPT, and open-source models.
# Get one at https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-...

# Anthropic (if you uncomment Option B in rag_starter.py)
# ANTHROPIC_API_KEY=sk-ant-...

# OpenAI (if you uncomment Option C in rag_starter.py)
# OPENAI_API_KEY=sk-...
